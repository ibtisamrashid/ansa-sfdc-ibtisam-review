    <description>9/23 - Added Related Sequence to Scale Up line
7/13 - Updated Scale Up Mass and Dates
When a quote line item has scale up added or removed, it updates a related scale up line</description>
    <environments>Default</environments>
    <formulas>
        <name>AOTG_Applicable</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    {!Sequence_Classification} = &quot;Guaranteed&quot;,
    {!$Record.ABT_Quote_Request__r.ABT_Account__r.AOTG_Applicable__c} = TRUE
)</expression>
    </formulas>
    <formulas>
        <name>New_AOTG_Calculation</name>
        <dataType>Number</dataType>
        <expression>{!$Record.ABT_Quote_Line_Item__r.AOTG_Calculation__c}+6</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>New_As_Early_As_Date</name>
        <dataType>Date</dataType>
        <expression>{!$Record.As_Early_As_Date__c}+6</expression>
    </formulas>
    <formulas>
        <name>Previous_AOTG_Calculation</name>
        <dataType>Number</dataType>
        <expression>{!$Record.ABT_Quote_Line_Item__r.AOTG_Calculation__c}-6</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Previous_As_Early_As_Date</name>
        <dataType>Date</dataType>
        <expression>{!$Record.As_Early_As_Date__c}-6</expression>
    </formulas>
    <formulas>
        <name>Product_ID_Calculator</name>
        <dataType>String</dataType>
        <expression>&quot;01tVH00000DxPFpYAN&quot;</expression>
    </formulas>
    <formulas>
        <name>ProductCodeCalculator</name>
        <dataType>String</dataType>
        <expression>&quot;GS-001&quot;</expression>
    </formulas>
    <formulas>
        <name>Scale_Up_Mass_Calculation</name>
        <dataType>String</dataType>
        <expression>IF(
    OR(
        TEXT({!$Record.Vector__r.Copy_Number__c}) = &quot;High&quot;,
        TEXT({!$Record.Vector__r.Copy_Number__c}) = &quot;Medium&quot;,
        TEXT({!$Record.Vector__r.Copy_Number__c}) = &quot;Inducible&quot;
    ),
    CASE(
        TEXT({!$Record.Scale_Up_Quantity__c}),
        &quot;1&quot;, &quot;500 µg&quot;,
        &quot;2&quot;, &quot;1 mg&quot;,
        &quot;3&quot;, &quot;1.5 mg&quot;,
        &quot;4&quot;, &quot;2 mg&quot;,
        &quot;5&quot;, &quot;2.5 mg&quot;,
        &quot;&quot;
    ),
    IF(
            TEXT({!$Record.Vector__r.Copy_Number__c}) = &quot;Low&quot;
        ,
        CASE(
            TEXT({!$Record.Scale_Up_Quantity__c}),
            &quot;1&quot;, &quot;100 µg&quot;,
            &quot;2&quot;, &quot;200 µg&quot;,
            &quot;3&quot;, &quot;300 µg&quot;,
            &quot;4&quot;, &quot;400 µg&quot;,
            &quot;5&quot;, &quot;500 µg&quot;,
            &quot;&quot;
        ),
        &quot;&quot;
    )
)</expression>
    </formulas>
    <formulas>
        <name>Scale_Up_Price_Formula</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.ABT_Quote_Line_Item__r.Scale_Up_Quantity__c}*325</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Sequence_Classification</name>
        <dataType>String</dataType>
        <expression>IF(
    ISPICKVAL({!$Record.ABT_Quote_Line_Item__r.Feasibility_Classifier__c}, &quot;Feasible&quot;),
    &quot;Guaranteed&quot;,
    IF(
        ISPICKVAL({!$Record.ABT_Quote_Line_Item__r.Feasibility_Classifier__c}, &quot;Borderline&quot;),
        &quot;Let&apos;s Try&quot;,
        &quot;&quot;
    )
)</expression>
    </formulas>
